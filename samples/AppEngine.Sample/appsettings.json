{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "CacheOptions": {
        "EnableOptions": true,
        "EnableDefaultEntryOptions": true,
        "EnableDistributedCache": true,
        "EnableBackplane": true,
        "EnableDistributedLocker": true,
        "ListEntryOptions": [],
        "EnableSystemTextJsonSerializer": true
    },
    "FusionCacheEntrySettings": {
        "Duration": "00:05:00", // 5 minutes
        "IsFailSafeEnabled": false,
        "FailSafeMaxDuration": "01:00:00", // 1 hour
        "FailSafeThrottleDuration": "00:05:00", // 5 minutes
        "EagerRefreshThreshold": 0.9, // value expressed as a float
        //"FactorySoftTimeout": "00:00:00:100", // 100 milliseconds
        //"FactoryHardTimeout": "00:00:00:1500" // 1500 milliseconds"
        "FactorySoftTimeout": "00:00:01", // 1 second
        "FactoryHardTimeout": "00:00:05" // 5 seconds
    },
    "FusionCacheDistributedOptions": {
        "DistributedCacheSoftTimeout": "00:00:01", // 1 second
        "DistributedCacheHardTimeout": "00:00:02", // 2 seconds"
        "AllowBackgroundDistributedCacheOperations": false,
        "CachePath": "" // Used for SQLite distributed cache, if enabled
    },
    "JitterOptions": {
        "DistributedCacheCircuitBreakerDuration": "00:00:02", // 2 seconds
        "JitterMaxDuration": "00:00:02" // 2 seconds
    },
    "FusionCacheEnabledOptions": {
        "EnableAllFusionCacheOptions": false,
        "EnableDefaultEntryOptions": false,
        "EnableSystemTextJsonSerializer": false,
        "EnabledEntryOptions": [],
        "DistributedCacheType": "Redis",
        "EnableDistributedCache": false,
        "EnableBackplane": false,
        "EnableDistributedLocker": false
    },
    "LoggingOptions": {
        "FailSafeActivationLogLevel": "Debug",
        "SerializationErrorsLogLevel": "Warning",
        "DistributedCacheSyntheticTimeoutsLogLevel": "Debug",
        "DistributedCacheErrorsLogLevel": "Error",
        "FactorySyntheticTimeoutsLogLevel": "Debug",
        "FactoryErrorsLogLevel": "Error"
    },
    "RedisCacheOptions": {
        "Configuration": "" // Replace with your Redis connection string
    },
    "RedisBackplaneOptions": {
        "Configuration": "" // Replace with your Redis connection string
    },
    "MuxerRedisConnectionString": "", // Replace with your Redis connection string
    "TypeDistributedCache": "SQLite", // Options are: "Redis", "SQLite"
    "AllowedHosts": "*"
}